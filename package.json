{
  "name": "lse-product-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-counter-index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch:products": "node scripts/fetch-products.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data": "vitest run tests/unit/data-integrity.test.ts",
    "test:e2e": "playwright test",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "fetch:docs": "node scripts/fetch-docs.mjs"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
